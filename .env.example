DBMAP_LAN_IP=
DBMAP_HTTPS_PORT=8443
DBMAP_PUBLIC_BASE_PATH=
DBMAP_PUBLIC_HUB_URL=
DBMAP_PUBLIC_HUB_HOST=
DBMAP_HUB_ID=local-01
DBMAP_ADMIN_TOKEN=
DBMAP_VIEWER_TOKEN=
DBMAP_OPA_DECISION_URL=https://opa:8181/v1/data/dbmap/authz/allow
DBMAP_MQTT_HUB_PASSWORD=
DBMAP_DYNSEC_ADMIN_PASSWORD=
DBMAP_PUBLIC_MQTT_HOST=hub.local
DBMAP_PUBLIC_MQTT_PORT=8883
DBMAP_LOCAL_MQTT_HOST=hub.local
DBMAP_LOCAL_MQTT_PORT=8883
DBMAP_NTP_SERVER=se.pool.ntp.org

# Hub health/availability monitor (defaults shown; omit to use defaults)
# DBMAP_HUB_MONITOR_ENABLED=true
# DBMAP_HUB_MONITOR_INTERVAL_S=60
# DBMAP_HUB_MONITOR_RETENTION_DAYS=90

# Device Hub-observed availability (D0). Online = last_seen within window.
# DBMAP_DEVICE_ONLINE_WINDOW_S=90
# DBMAP_DEVICE_MONITOR_ENABLED=true
# DBMAP_DEVICE_MONITOR_RETENTION_DAYS=90
# DBMAP_DEVICE_MONITOR_MAX_SAMPLES_PER_DEVICE=500
# DBMAP_DEVICE_MONITOR_MAX_EVENTS_PER_DEVICE=500

# Device-reported diag ingest (D2). Hard ceiling 30 events/device.
# DBMAP_DEVICE_DIAG_ENABLED=true
# DBMAP_DEVICE_DIAG_MAX_EVENTS_PER_DEVICE=30
# DBMAP_DEVICE_DIAG_RSSI_DEGRADED_DBM=-80
# DBMAP_DEVICE_DIAG_AGGREGATE_WINDOW_S=3600
