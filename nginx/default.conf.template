server {
    listen ${DBMAP_HTTPS_PORT} ssl;
    server_name _;
    server_tokens off;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Container IPs may change on recreation; query Docker DNS at request time.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $hub_bootstrap_upstream hub-bootstrap:8443;
    set $dbmap_web_upstream dbmap-web:443;
    set $firmware_builder_upstream firmware-builder:8443;
    set $dbmap_public_base_path "${DBMAP_PUBLIC_BASE_PATH}";

    ssl_certificate /certs/nginx.crt;
    ssl_certificate_key /certs/nginx.key;

    error_page 404 /dbmap-404.html;
    error_page 500 502 503 504 /dbmap-unavailable.html;

    sub_filter_once on;
    sub_filter '</head>' '<meta name="dbmap-base-path" content="${DBMAP_PUBLIC_BASE_PATH}"></head>';

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    location = /dbmap-404.html {
        internal;
        root /usr/share/nginx/html;
    }

    location = /dbmap-unavailable.html {
        internal;
        root /usr/share/nginx/html;
    }

    location = / {
        if ($dbmap_public_base_path != "") {
            return 308 $dbmap_public_base_path/;
        }
        proxy_pass https://$dbmap_web_upstream/;
        proxy_ssl_server_name on;
        proxy_ssl_name dbmap-web;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /certs/ca.crt;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location ~ ^(?<esp_request_base>/[^/]+(?:/[^/]+)*)?(?<esp_uri>/espconnect(?:/.*)?)$ {
        if ($esp_request_base != $dbmap_public_base_path) { return 404; }
        if ($esp_uri = /espconnect) { return 308 $dbmap_public_base_path/espconnect/; }
        proxy_pass https://$dbmap_web_upstream$esp_uri;
        proxy_ssl_server_name on;
        proxy_ssl_name dbmap-web;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /certs/ca.crt;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location ~ ^(?<map_request_base>/[^/]+(?:/[^/]+)*)?(?<map_uri>/map(?:/.*)?)$ {
        if ($map_request_base != $dbmap_public_base_path) { return 404; }
        if ($map_uri = /map) { return 308 $dbmap_public_base_path/map/; }
        proxy_pass https://$dbmap_web_upstream$map_uri;
        proxy_ssl_server_name on;
        proxy_ssl_name dbmap-web;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /certs/ca.crt;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location ~ ^(?<ewt_request_base>/[^/]+(?:/[^/]+)*)?(?<ewt_uri>/esp-web-tools(?:/.*)?)$ {
        if ($ewt_request_base != $dbmap_public_base_path) { return 404; }
        proxy_pass https://$dbmap_web_upstream$ewt_uri;
        proxy_ssl_server_name on;
        proxy_ssl_name dbmap-web;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /certs/ca.crt;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # USB chip inspection helper + vendored esptool-js (needed when public base path is empty;
    # otherwise the only_base rule would 404 single-segment paths like /usb-chip-inspect.js).
    location ~ ^(?<chip_request_base>/[^/]+(?:/[^/]+)*)?(?<chip_uri>/(?:usb-chip-inspect\.js|esptool-js(?:/.*)?))$ {
        if ($chip_request_base != $dbmap_public_base_path) { return 404; }
        proxy_pass https://$dbmap_web_upstream$chip_uri;
        proxy_ssl_server_name on;
        proxy_ssl_name dbmap-web;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /certs/ca.crt;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location ~ ^(?<request_base>/[^/]+(?:/[^/]+)*)?(?<health_uri>/health)$ {
        if ($request_base != $dbmap_public_base_path) { return 404; }
        proxy_pass https://$hub_bootstrap_upstream$health_uri;
        proxy_ssl_server_name on;
        proxy_ssl_name hub-bootstrap;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /certs/ca.crt;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
    }

    # Proxy firmware builder API via HTTPS (firmware-builder terminates TLS with its own cert)
    location ~ ^(?<build_request_base>/[^/]+(?:/[^/]+)*)?(?<build_api_uri>/api/v1/firmware/(?:targets|builds(?:/.*)?))$ {
        if ($build_request_base != $dbmap_public_base_path) { return 404; }
        error_page 502 503 504 = @firmware_builder_unavailable;
        proxy_pass https://$firmware_builder_upstream$build_api_uri$is_args$args;
        proxy_ssl_server_name on;
        proxy_ssl_name firmware-builder;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /certs/ca.crt;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location @firmware_builder_unavailable {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        return 503 '{"detail":"Optional firmware builder is not running. Start it with docker compose --profile firmware-build up -d firmware-builder nginx."}';
    }

    location ~ ^(?<request_base>/[^/]+(?:/[^/]+)*)?(?<api_uri>/api/.*)$ {
        if ($request_base != $dbmap_public_base_path) { return 404; }
        if ($api_uri !~ ^/api/v1/) { return 404; }
        proxy_pass https://$hub_bootstrap_upstream$api_uri$is_args$args;
        proxy_ssl_server_name on;
        proxy_ssl_name hub-bootstrap;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /certs/ca.crt;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
    }

    location ~ ^(?<only_base>/[^/]+(?:/[^/]+)*)$ {
        if ($only_base != $dbmap_public_base_path) { return 404; }
        return 308 $only_base/;
    }

    location ~ ^(?<request_base>/[^/]+(?:/[^/]+)*)?(?<ui_uri>/.*)$ {
        if ($request_base != $dbmap_public_base_path) { return 404; }
        proxy_pass https://$dbmap_web_upstream$ui_uri;
        proxy_ssl_server_name on;
        proxy_ssl_name dbmap-web;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /certs/ca.crt;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
