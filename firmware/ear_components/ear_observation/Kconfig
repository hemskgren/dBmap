menu "dBmap Ear Observation"
    depends on DBMAP_NODE_TYPE_EAR

    config DBMAP_EAR_OBS_SEQ_BLOCK_SIZE
        int "Sequence-number block size reserved per NVS write"
        range 8 4096
        default 64
        help
            NVS stores an exclusive sequence limit. RAM allocates within the
            reserved block. Larger blocks mean fewer NVS writes; unused numbers
            in a block are skipped after reboot (gaps OK, never reused).

    config DBMAP_EAR_OBS_RMS_ACTIVITY
        bool "Phase 2: RMS acoustic activity detector"
        default y
        help
            Detect aggregate acoustic activity from windowed RMS (not source
            classification). Emits start/periodic/end Observations. Detection
            continues while MQTT is disconnected; undelivered emissions are
            dropped without consuming sequence numbers.

    config DBMAP_EAR_OBS_ENTER_THRESHOLD_DBFS_X1000
        int "RMS enter threshold (dBFS × 1000)"
        range -120000 0
        default -45000
        depends on DBMAP_EAR_OBS_RMS_ACTIVITY
        help
            Provisional: enter activity when rms_dbfs >= this value / 1000.
            Example -45000 → -45.0 dBFS. Not calibrated.

    config DBMAP_EAR_OBS_EXIT_THRESHOLD_DBFS_X1000
        int "RMS exit threshold (dBFS × 1000)"
        range -120000 0
        default -55000
        depends on DBMAP_EAR_OBS_RMS_ACTIVITY
        help
            Provisional hysteresis: leave activity when rms_dbfs < this / 1000.
            Must be quieter than the enter threshold (more negative). Example
            -55000 → -55.0 dBFS. Not calibrated.

    config DBMAP_EAR_OBS_MIN_ACTIVITY_MS
        int "Minimum activity duration before START emission (ms)"
        range 100 60000
        default 2000
        depends on DBMAP_EAR_OBS_RMS_ACTIVITY

    config DBMAP_EAR_OBS_EXIT_HOLD_MS
        int "Time below exit threshold before END emission (ms)"
        range 100 60000
        default 1000
        depends on DBMAP_EAR_OBS_RMS_ACTIVITY

    config DBMAP_EAR_OBS_BOOT_SETTLE_MS
        int "Ignore measurements for this long after I2S enable (ms)"
        range 0 120000
        default 5000
        depends on DBMAP_EAR_OBS_RMS_ACTIVITY
        help
            Suppresses boot-time floating-DIN / unstable I2S windows. Does not
            treat settle as acoustic silence.

    config DBMAP_EAR_OBS_INTERVAL_MS
        int "Periodic Observation interval while active (ms)"
        range 1000 300000
        default 5000
        depends on DBMAP_EAR_OBS_RMS_ACTIVITY

    config DBMAP_EAR_OBS_MAX_INVALID_HOLD_MS
        int "Force END after this long without usable samples (ms)"
        range 1000 600000
        default 30000
        depends on DBMAP_EAR_OBS_RMS_ACTIVITY
        help
            Invalid/missing measurements are never treated as silence, but an
            activity episode must not remain open forever if the mic path stays
            unusable. After this hold, emit END ending at the last usable
            sample. Exit-hold and periodic timers do not advance during invalid
            windows.

    config DBMAP_EAR_OBS_RELATIVE_END
        bool "Relative END: freeze pre-event RMS baseline for exit"
        default y
        depends on DBMAP_EAR_OBS_RMS_ACTIVITY
        help
            When enabled, END can trigger when RMS returns near a frozen
            pre-event baseline (median of up to five IDLE below-enter windows),
            even if ambient is above the absolute exit threshold. Absolute exit
            remains the fallback when the baseline is unreliable or Relative END
            is not armed. Field-test feature — parameters below are provisional,
            not validated production thresholds. When disabled, detector behavior
            matches absolute-only END. Default enabled for EAR field validation.

    config DBMAP_EAR_OBS_REL_RETURN_MARGIN_DB_X1000
        int "Relative END return margin (dB × 1000)"
        range 0 40000
        default 4000
        depends on DBMAP_EAR_OBS_RELATIVE_END
        help
            Provisional field-test value (4000 → 4.0 dB). Relative entry when
            rms <= frozen_baseline + margin. Not a calibrated production default.

    config DBMAP_EAR_OBS_REL_EXIT_HOLD_MS
        int "Relative END exit hold (ms)"
        range 100 60000
        default 2000
        depends on DBMAP_EAR_OBS_RELATIVE_END
        help
            Provisional field-test value. Hold while relative mode is latched
            before emitting natural END.

    config DBMAP_EAR_OBS_REL_CANCEL_HYST_DB_X1000
        int "Relative END cancel hysteresis (dB × 1000)"
        range 0 20000
        default 1500
        depends on DBMAP_EAR_OBS_RELATIVE_END
        help
            Provisional field-test value (1500 → 1.5 dB). Cancel PENDING_EXIT
            when rms > baseline + return_margin + hysteresis.

    config DBMAP_EAR_OBS_REL_MIN_CONTRAST_DB_X1000
        int "Relative END min event contrast (dB × 1000)"
        range 0 60000
        default 5000
        depends on DBMAP_EAR_OBS_RELATIVE_END
        help
            Provisional field-test value (5000 → 5.0 dB). Relative END arms only
            when max(RMS of first two episode windows) - baseline >= contrast.

    config DBMAP_EAR_OBS_REL_BASELINE_STALE_MS
        int "Pre-event baseline stale window (ms)"
        range 0 300000
        default 15000
        depends on DBMAP_EAR_OBS_RELATIVE_END
        help
            Drop IDLE baseline candidates older than this before freeze.
            0 disables staleness filtering. Provisional field-test value.

    config DBMAP_EAR_OBS_TEST_PUBLISH_ONCE
        bool "Phase 1: publish one test Observation after MQTT connects"
        default n
        help
            Controlled Phase 1 trigger. Prefer the RMS activity detector for
            ongoing Observations. Enable only for publisher bring-up without
            the detector.

    config DBMAP_EAR_OBS_TEST_SIGNAL_LEVEL_DBFS
        int "Phase 1 placeholder signal_level_dbfs × 1000 when mic RMS unavailable"
        range -120000 0
        default -60000
        depends on DBMAP_EAR_OBS_TEST_PUBLISH_ONCE
        help
            Used only when the microphone has not yet produced a measurement
            window. Value is thousandths of a dBFS (e.g. -60000 → -60.0 dBFS).

    config DBMAP_EAR_OBS_TEST_DURATION_MS
        int "Phase 1 test Observation duration_ms when mic window unknown"
        range 1 5000
        default 1000
        depends on DBMAP_EAR_OBS_TEST_PUBLISH_ONCE

    config DBMAP_EAR_OBS_L0
        bool "Step 2: accumulate L0 over Observation intervals"
        default y
        depends on DBMAP_EAR_OBS_RMS_ACTIVITY && DBMAP_EAR_MIC_L0
        help
            Associate usable L0 analysis windows with START/PERIODIC/END
            Observation boundaries and finalize interval aggregates.
            Required when publishing L0 measurements on MQTT.

    config DBMAP_EAR_OBS_L0_MAX_WINDOWS
        int "Max usable L0 analysis windows per Observation interval"
        range 8 128
        default 64
        depends on DBMAP_EAR_OBS_L0
        help
            Static ring/history capacity. Supported observation_interval_ms is
            at most (this value - 2) * analysis window_ms under exclusive-start
            inclusive-end membership. Default 64 → ~62 s at 1 s windows.
            If configured INTERVAL_MS needs more windows, observation start
            fails clearly (no silent truncation of T1/T2/T3/T6).

    config DBMAP_EAR_OBS_PUBLISH_L0
        bool "Publish emission_kind + L0 measurements on Observations (protocol v1)"
        default n
        depends on DBMAP_EAR_OBS_RMS_ACTIVITY && DBMAP_EAR_OBS_L0 && DBMAP_EAR_MIC_L0
        help
            When enabled, MQTT Observations remain protocol_version 1 but include
            emission_kind and a required nested measurements (L0) object.
            Keep disabled until Hub accepts the extension. Incomplete L0 runtime
            state refuses publish (no silent omission of measurements).

    config DBMAP_EAR_OBS_L1
        bool "Step 3: L1 Acoustic Signature (FFT features on Observation intervals)"
        default y
        depends on DBMAP_EAR_OBS_RMS_ACTIVITY && DBMAP_EAR_MIC_L0 && DBMAP_EAR_OBS_L0
        help
            Compute interval-scoped L1 spectral signature (centroid, bandwidth,
            dominant frequency, flatness) from the existing SPIRAM PCM buffer
            using 1024-pt Hann FFTs. Uses the same window association rule and
            history capacity as L0, but aggregation state is independent.
            When enabled, acoustic.signature is a schema=l1 object (or a valid
            empty L1 object). When disabled, acoustic.signature is JSON null.
            Does not change L0 formulas, detector thresholds, or Observation
            lifecycle. Analysis runs in the observation task only.

    config DBMAP_EAR_OBS_L2
        bool "L2 Acoustic Dynamics computation"
        default n
        depends on DBMAP_EAR_OBS_L1 && DBMAP_EAR_OBS_L0 && DBMAP_EAR_MIC_L0
        help
            Compute spectral_flux, envelope_cv, and dominant_delta_hz using the
            fused L1 FFT path (no second PCM/FFT pass). Continuity cache and
            interval aggregates are maintained for diagnostics. Does not publish
            acoustic.dynamics unless DBMAP_EAR_OBS_L2_PUBLISH is also enabled.

    config DBMAP_EAR_OBS_L2_PUBLISH
        bool "Publish acoustic.dynamics on Observations"
        default n
        depends on DBMAP_EAR_OBS_L2
        help
            Emit a non-null acoustic.dynamics object on MQTT Observations.
            Requires Hub acceptance of the L2 schema. Keep disabled for
            compute-only EAR-001 validation.

    config DBMAP_EAR_OBS_SERIAL_DIAG
        bool "Opt-in serial diagnostics for RMS activity (rate-limited)"
        default n
        depends on DBMAP_EAR_OBS_RMS_ACTIVITY
        help
            When enabled, the activity task prints ~1 Hz measurement/state
            snapshots and ~5 s emission/invalid/MQTT-drop counters on the
            console UART. Also one-shot: first 5 post-boot-settle usable
            windows (rms/peak/seq/status) and each Relative END baseline_freeze
            (accepted samples + frozen median). When DBMAP_EAR_OBS_L0 is also
            enabled, prints per-window L0 and per-emission interval L0
            summaries, L1 analyze counters (when L1 on), and runtime CPU MHz /
            heap. Independent of MQTT/HTTPS. Default off. Does not change
            thresholds, hysteresis, timing, or Observation emission. Do not
            enable in production fleet images.

    config DBMAP_EAR_OBS_LIFECYCLE_V2
        bool "Experimental Observation lifecycle v2 (signature persistence)"
        default n
        depends on DBMAP_EAR_OBS_RMS_ACTIVITY && DBMAP_EAR_OBS_L0 && DBMAP_EAR_OBS_L1 && DBMAP_EAR_OBS_L2
        help
            Experimental: replace absolute-RMS-only END with signature-score
            persistence, quiet fallback, max episode age, and START pre-trigger
            lookback using existing L0/L1/L2 scalar rings. Keep disabled until
            offline comparison and review complete. When disabled, Phase-2 RMS
            detector behavior is unchanged.

    config DBMAP_EAR_OBS_LC_V2_PRE_TRIGGER_MS
        int "Lifecycle v2 START pre-trigger lookback (ms)"
        range 1000 3000
        default 2000
        depends on DBMAP_EAR_OBS_LIFECYCLE_V2

    config DBMAP_EAR_OBS_LC_V2_MAX_EPISODE_MS
        int "Lifecycle v2 maximum Observation age (ms)"
        range 10000 3600000
        default 120000
        depends on DBMAP_EAR_OBS_LIFECYCLE_V2
        help
            Hard END (termination_reason natural) after this episode age.

    config DBMAP_EAR_OBS_LC_V2_SCORE_ENTER_X1000
        int "Lifecycle v2 signature score enter (×1000)"
        range 0 1000
        default 400
        depends on DBMAP_EAR_OBS_LIFECYCLE_V2

    config DBMAP_EAR_OBS_LC_V2_SCORE_EXIT_X1000
        int "Lifecycle v2 signature score exit (×1000)"
        range 0 1000
        default 320
        depends on DBMAP_EAR_OBS_LIFECYCLE_V2

    config DBMAP_EAR_OBS_LC_V2_PERSISTENCE_WINDOWS
        int "Lifecycle v2 persistent score window count"
        range 1 8
        default 3
        depends on DBMAP_EAR_OBS_LIFECYCLE_V2

    config DBMAP_EAR_OBS_LC_V2_SIGNATURE_EXIT_HOLD_MS
        int "Lifecycle v2 signature exit hold (ms)"
        range 100 60000
        default 2000
        depends on DBMAP_EAR_OBS_LIFECYCLE_V2

    config DBMAP_EAR_OBS_LC_V2_QUIET_EXIT_HOLD_MS
        int "Lifecycle v2 quiet-fallback exit hold (ms)"
        range 100 60000
        default 1000
        depends on DBMAP_EAR_OBS_LIFECYCLE_V2

endmenu
