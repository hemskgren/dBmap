CONFIG_IDF_TARGET="esp32s3"
# Desired → HTTPS OTA (mbedTLS) runs on main; 8 KiB overflowed with a 4 KiB on-stack
# download buffer. Buffer is now static; keep 16 KiB headroom for TLS + OTA close.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
# Hardware profile esp32-s3-n16r8 verified via ESPConnect on the physical board:
# ESP32-S3 QFN56 rev v0.2, 16 MB flash (ID 0x184068), 8 MB embedded PSRAM (AP Memory 3.3 V).
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_MQTT_PROTOCOL_311=y
CONFIG_LWIP_DNS_SUPPORT_MDNS_QUERIES=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_APP_PROJECT_VER_FROM_CONFIG=y
CONFIG_APP_PROJECT_VER="0.8.0"
CONFIG_DBMAP_FIRMWARE_VERSION="0.8.0"
CONFIG_DBMAP_NODE_TYPE_EAR=y
CONFIG_DBMAP_HARDWARE_REVISION="esp32-s3-n16r8"
CONFIG_DBMAP_EAR_MIC_MODEL_INMP441=y
# I2S pin defaults are UNVERIFIED placeholders — see ear_mic Kconfig help.
# Phase 2: RMS activity detector (thresholds provisional / uncalibrated).
CONFIG_DBMAP_EAR_OBS_RMS_ACTIVITY=y
CONFIG_DBMAP_EAR_OBS_TEST_PUBLISH_ONCE=n
CONFIG_DBMAP_EAR_OBS_SEQ_BLOCK_SIZE=64
# Relative END v1: freeze pre-event RMS baseline for exit (provisional params).
CONFIG_DBMAP_EAR_OBS_RELATIVE_END=y
# Rel END late sustained contrast arm (two consecutive ACTIVE windows ≥ min contrast).
CONFIG_DBMAP_EAR_OBS_REL_LATE_ARM=y
# Rel END v2 A3 Secondary Ambient Exit (Kconfig defaults: jump 10 dB, 5 windows, range 3 dB).
CONFIG_DBMAP_EAR_OBS_REL_SECONDARY_AMBIENT=y
# L0 analysis on-device; MQTT protocol v1 with emission_kind + measurements.
CONFIG_DBMAP_EAR_MIC_L0=y
CONFIG_DBMAP_EAR_OBS_L0=y
CONFIG_DBMAP_EAR_OBS_L0_MAX_WINDOWS=64
CONFIG_DBMAP_EAR_OBS_PUBLISH_L0=y
# L1 Acoustic Signature (1024-pt FFT features on Observation intervals).
CONFIG_DBMAP_EAR_OBS_L1=y
# L2 Acoustic Dynamics: compute and publish acoustic.dynamics on Observations.
CONFIG_DBMAP_EAR_OBS_L2=y
CONFIG_DBMAP_EAR_OBS_L2_PUBLISH=y
# Serial diagnostics (RMS activity + L0).
CONFIG_DBMAP_EAR_OBS_SERIAL_DIAG=y
# Multi-mic capture UART (~5s): ch0–ch3 slot, rms/peak, n/expect, window_seq, incomplete.
# Needed for multi-mic bench on USB console after win# stops at 30. Turn off for
# production fleet images if UART noise is unwanted (Kconfig / menuconfig).
CONFIG_DBMAP_EAR_MIC_CAPTURE_DIAG=y
