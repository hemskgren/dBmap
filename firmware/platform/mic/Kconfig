menu "dBmap Ear microphone"
    depends on DBMAP_NODE_TYPE_EAR

    choice DBMAP_EAR_MIC_MODEL
        prompt "Microphone model (one per Ear image)"
        default DBMAP_EAR_MIC_MODEL_INMP441
        help
            Each Ear firmware image is built for exactly one microphone model.
            Additional models can be added later without mixing types on one device.

        config DBMAP_EAR_MIC_MODEL_INMP441
            bool "INMP441 (I2S MEMS)"
    endchoice

    config DBMAP_EAR_MIC_SAMPLE_RATE_HZ
        int "Capture sample rate (Hz)"
        range 8000 48000
        default 16000

    config DBMAP_EAR_MIC_WINDOW_MS
        int "Measurement window (ms)"
        range 100 5000
        default 1000
        help
            Latest window metrics are attached to hello/health/keepalive reported
            state (like wifi_rssi_dbm). There is no separate audio MQTT topic yet.

    config DBMAP_EAR_MIC_I2S_BCLK_GPIO
        int "I2S BCLK GPIO (UNVERIFIED placeholder)"
        range 0 48
        default 4
        help
            Shared bit clock for all INMP441s. Placeholder only — see
            docs/device-wiring-and-pinout.md. Confirm free GPIOs on the board
            before treating this map as verified.

    config DBMAP_EAR_MIC_I2S_WS_GPIO
        int "I2S WS / LRCLK GPIO (UNVERIFIED placeholder)"
        range 0 48
        default 5
        help
            Shared word select for all INMP441s.

    config DBMAP_EAR_MIC_I2S_DIN_GPIO
        int "I2S DIN0 GPIO for mic 0 (+ mic 1 when stereo)"
        range 0 48
        default 6
        help
            First data line (I2S0 RX master). Mic index 0 = left (L/R to GND);
            mic index 1 = right (L/R to VDD) when microphone_count >= 2.
            Indexes are 0-based. Placeholder — see device-wiring-and-pinout.md.

    config DBMAP_EAR_MIC_I2S_DIN1_GPIO
        int "I2S DIN1 GPIO for mic 2+3 (-1 unused)"
        range -1 48
        default 7
        help
            Second data line (I2S1 RX slave sharing BCLK/WS). Mic index 2 =
            left, mic index 3 = right when microphone_count is 3 or 4.
            Required when live count >= 3; set -1 only for boards without DIN1.
            Placeholder pin — confirm free GPIO before treating as verified.

    config DBMAP_EAR_MIC_I2S_MCLK_GPIO
        int "I2S MCLK GPIO (-1 unused)"
        range -1 48
        default -1

    config DBMAP_EAR_MIC_L0
        bool "Compute L0 features per analysis window"
        default y
        help
            Retain each completed 1 s analysis window as double-buffered SPIRAM
            PCM for product acoustic analysis (ear_acoustic L0/L1/L2). I2S
            capture is not blocked by analysis. Not used by the RMS activity
            detector. Disable to reclaim SPIRAM (~2 × window PCM) when unused.

    config DBMAP_EAR_MIC_BACKGROUND
        bool "Rolling background RMS on Reported State (per live mic)"
        default y
        help
            Maintain an independent rolling RMS history for each live/acquired
            microphone and attach audio.microphones[i].background on
            hello/health/keepalive when that mic has in-window samples.
            Independent of Observation/MQTT. Read-only on publish. Disable to
            reclaim static RAM (one hist ring per SP_MIC_COUNT_MAX).

    config DBMAP_EAR_MIC_BACKGROUND_WINDOW_MS
        int "Background RMS rolling window (ms)"
        depends on DBMAP_EAR_MIC_BACKGROUND
        range 10000 600000
        default 180000
        help
            Samples older than this duration are outside the Reported State
            profile (snapshot time-filters; ring may also drop on insert).

    config DBMAP_EAR_MIC_BACKGROUND_BOOT_SETTLE_MS
        int "Exclude background samples this long after I2S enable (ms)"
        depends on DBMAP_EAR_MIC_BACKGROUND
        range 0 120000
        default 5000
        help
            Reuses the same startup-settle idea as the activity detector
            (ms_since_i2s_enable). Also excludes window_seq == 1.

    config DBMAP_EAR_MIC_CAPTURE_DIAG
        bool "Opt-in UART capture diagnostics (multi-mic / DMA / RAM)"
        default n
        help
            Periodic console lines with sample-rate, slot mode, per-channel
            (indexes 0–3) counts/RMS/peak/clip/presence, incomplete stereo
            frames, DMA descriptor/frame values actually passed to
            i2s_new_channel, and heap/SPIRAM. Does not change Observation JSON
            or Hub schemas. Enable for EAR multi-mic bring-up; leave off for
            fleet images.

endmenu
