  "target": "Recognize the shared continuous public-warning siren sound (not full message classification)",
  "ae_signature_schema_version": 1,
  "related_profiles": {
    "VMA": {
      "status": "not_a_separate_AS_profile_yet",
      "shared": "Same characteristic siren timbre / tonal midband energy",
      "difference": "VMA temporal pattern \u22487 s on / \u224814 s silence repeating; Faran \u00f6ver \u224830 s continuous",
      "this_task": "Do not implement a VMA classifier; document the shared acoustic core only"
    }
  },
